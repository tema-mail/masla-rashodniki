---
import { brands, type Model, type Row } from '../data/brands';

const sorted = [...brands].sort((a, b) => a.name.localeCompare(b.name, 'en'));
const modelCount = sorted.reduce((n, b) => n + b.models.length, 0);
const needsCheck = (m: Model) => m.check || m.rows.some((r) => r.check);
const checkCount = sorted.reduce((n, b) => n + b.models.filter(needsCheck).length, 0);

// Группа строки по названию узла: порядок проверок важен ("ОЖ для ДВС" – это жидкость).
const GROUPS = ['Трансмиссия', 'Двигатель', 'Жидкости', 'Фильтры и запчасти'] as const;
const groupOf = (name: string) => {
  if (/фильтр|колодк|свеч|рычаг|бачок|стойк|шаров|пыльник/i.test(name)) return 3;
  if (/тормозн|охлажд|антифриз|ОЖ|фреон|хладагент|кондиц|омыв|топлив|мочевин|гидроусил/i.test(name)) return 2;
  if (/ДВС|моторное|двигател/i.test(name) && !/электродвигател|электроуправлен/i.test(name)) return 1;
  return 0;
};
const grouped = (rows: Row[]) =>
  GROUPS.map((title, i) => ({ title, rows: rows.filter((r) => groupOf(r.name) === i) })).filter((g) => g.rows.length);

// Текст карточки для поиска: марка + всё, что в ней написано.
const searchText = (brand: string, m: Model) =>
  [
    brand,
    m.name,
    m.sub,
    m.code,
    m.note,
    needsCheck(m) && 'надо проверить',
    ...m.rows.flatMap((r) => [r.name, r.spec, r.oil, r.part, r.vol, r.note, ...(r.alt ?? [])]),
  ]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();

// Неразрывные пробелы в объёме, чтобы «л» и «± 0,1» не отрывались от числа.
const nb = (v: string) => v.replace(/ (±) /g, '\u00a0$1\u00a0').replace(/(\d) (л|мл|г)(?![а-яa-z])/g, '$1\u00a0$2');
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Масла и расходники</title>
    <meta name="description" content="Что заливать в редукторы, ДВС и системы электромобилей и гибридов: допуски, объёмы, аналоги, фильтры." />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cpath d='M16 3c5 7 9 12 9 17a9 9 0 0 1-18 0c0-5 4-10 9-17z' fill='%23d97706'/%3E%3C/svg%3E" />
  </head>
  <body>
    <header class="top">
      <div class="wrap">
        <h1>Масла и расходники</h1>
        <p class="lead">
          Редукторы, ДВС, охлаждающие и тормозные жидкости, фреон, фильтры. {sorted.length} марок, {modelCount} моделей.
        </p>
        <p class="legend"><span class="chk">Надо проверить</span> – собрано из открытых источников, а не из нашей таблицы. Перед заливкой сверить с машиной.</p>
      </div>
    </header>

    <div class="bar">
      <div class="wrap">
        <label class="search">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          <input id="q" type="search" placeholder="Модель, допуск, масло, артикул…" autocomplete="off" />
        </label>
        <label class="only"><input id="onlyCheck" type="checkbox" /> Только «надо проверить» ({checkCount})</label>
        <nav class="chips" aria-label="Марки">
          <button class="chip is-on" data-brand="">Все</button>
          {sorted.map((b) => <button class="chip" data-brand={b.id}>{b.name}</button>)}
        </nav>
      </div>
    </div>

    <main class="wrap">
      {
        sorted.map((b) => (
          <section class="brand" id={b.id} data-brand={b.id}>
            <h2>
              {b.name} <span class="count">{b.models.length}</span>
            </h2>
            <div class="grid">
              {b.models.map((m) => (
                <article class="card" data-search={searchText(b.name, m)} data-check={needsCheck(m) ? '1' : undefined}>
                  <header class="card-head">
                    <h3>{m.name}</h3>
                    {m.sub && <span class="sub">{m.sub}</span>}
                    {m.check && <span class="chk">Надо проверить</span>}
                  </header>
                  {m.nsk && <p class="code">На drom в Новосибирске: {m.nsk} объявл. (все поколения модели)</p>}

                  {m.code && <p class="code">{m.code}</p>}
                  <table class="spec">
                    <thead>
                      <tr>
                        <th>Узел</th>
                        <th>Чем заливать</th>
                        <th class="v">Объём</th>
                      </tr>
                    </thead>
                    {grouped(m.rows).map((g) => (
                      <tbody>
                        <tr class="grp">
                          <th colspan="3">{g.title}</th>
                        </tr>
                        {g.rows.map((r) => (
                          <tr>
                            <td class="n">
                              {r.name}
                              {r.check && !m.check && <span class="chk sm">проверить</span>}
                            </td>
                            <td>
                              {r.oil && <div class="oil">{r.oil}</div>}
                              {r.spec && <div class="meta">допуск {r.spec}</div>}
                              {r.part && <div class="meta">арт. <span class="mono">{r.part}</span></div>}
                              {r.alt &&
                                (r.alt.length > 2 ? (
                                  <details class="alt">
                                    <summary>аналоги · {r.alt.length}</summary>
                                    <ol>
                                      {r.alt.map((a) => (
                                        <li>{a}</li>
                                      ))}
                                    </ol>
                                  </details>
                                ) : (
                                  <div class="meta">аналог {r.alt.join(' · ')}</div>
                                ))}
                              {r.note && <div class="rnote">{r.note}</div>}
                              {r.src && (
                                <a class="src" href={r.src} target="_blank" rel="noopener noreferrer">
                                  источник
                                </a>
                              )}
                              {!r.oil && !r.spec && !r.part && !r.alt && !r.note && <span class="dash">–</span>}
                            </td>
                            <td class="v">{r.vol ? nb(r.vol) : <span class="dash">–</span>}</td>
                          </tr>
                        ))}
                      </tbody>
                    ))}
                  </table>

                  {m.note && <p class="note">{m.note}</p>}
                </article>
              ))}
            </div>
          </section>
        ))
      }
      <p class="empty" id="empty" hidden>Ничего не нашлось. Попробуйте другое слово или сбросьте марку.</p>
    </main>

    <footer class="wrap foot">Источник – таблица «МАСЛА и прочее», перенесено 22.10.2026.</footer>

    <script>
      const q = document.getElementById('q') as HTMLInputElement;
      const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
      const sections = [...document.querySelectorAll<HTMLElement>('.brand')];
      const empty = document.getElementById('empty')!;
      const onlyCheck = document.getElementById('onlyCheck') as HTMLInputElement;
      // Липкая панель меняет высоту (марки в 2–3 строки), отступ прокрутки считаем по ней.
      const bar = document.querySelector<HTMLElement>('.bar')!;
      const pad = () => (document.documentElement.style.scrollPaddingTop = bar.offsetHeight + 16 + 'px');
      pad();
      addEventListener('resize', pad);
      let brand = '';

      function apply() {
        const words = q.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
        let shown = 0;
        for (const s of sections) {
          const brandOk = !brand || s.dataset.brand === brand;
          let inSection = 0;
          for (const c of s.querySelectorAll<HTMLElement>('.card')) {
            const ok = brandOk && (!onlyCheck.checked || c.dataset.check === '1') && words.every((w) => c.dataset.search!.includes(w));
            c.hidden = !ok;
            if (ok) inSection++;
          }
          s.hidden = inSection === 0;
          shown += inSection;
        }
        empty.hidden = shown > 0;
      }

      for (const chip of chips) {
        chip.addEventListener('click', () => {
          brand = chip.dataset.brand ?? '';
          chips.forEach((c) => c.classList.toggle('is-on', c === chip));
          apply();
          const target = brand ? document.getElementById(brand) : null;
          (target ?? document.querySelector('main'))!.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', brand ? '#' + brand : location.pathname);
        });
      }
      q.addEventListener('input', apply);
      onlyCheck.addEventListener('change', apply);

      const fromHash = location.hash.slice(1);
      if (fromHash) chips.find((c) => c.dataset.brand === fromHash)?.click();
    </script>

    <style is:global>
      :root {
        --bg: #f6f5f2;
        --surface: #ffffff;
        --ink: #1b1c1e;
        --muted: #6b6e73;
        --line: #e4e2dc;
        --accent: #c2600a;
        --accent-soft: #fdf0e3;
        --chip: #ecebe6;
        --shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 4px 16px rgb(0 0 0 / 0.04);
        --warn: #fde68a;
        --warn-ink: #713f12;
        --warn-line: #f5d565;
        color-scheme: light;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          --bg: #121315;
          --surface: #1b1d20;
          --ink: #ececea;
          --muted: #9a9da3;
          --line: #2c2f33;
          --accent: #f0913a;
          --accent-soft: #3a2614;
          --chip: #25282c;
          --shadow: none;
          --warn: #4a3a0a;
          --warn-ink: #fcd34d;
          --warn-line: #6b5410;
          color-scheme: dark;
        }
      }
      :root[data-theme='dark'] {
        --bg: #121315;
        --surface: #1b1d20;
        --ink: #ececea;
        --muted: #9a9da3;
        --line: #2c2f33;
        --accent: #f0913a;
        --accent-soft: #3a2614;
        --chip: #25282c;
        --shadow: none;
        --warn: #4a3a0a;
        --warn-ink: #fcd34d;
        --warn-line: #6b5410;
        color-scheme: dark;
      }

      * { box-sizing: border-box; }
      html { scroll-padding-top: 150px; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font: 15px/1.45 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        -webkit-text-size-adjust: 100%;
      }
      .wrap { max-width: 1240px; margin: 0 auto; padding: 0 16px; }

      .top { padding: 32px 0 16px; }
      h1 { margin: 0; font-size: clamp(26px, 4vw, 38px); letter-spacing: -0.02em; }
      .lead { margin: 6px 0 0; color: var(--muted); }

      .bar {
        position: sticky;
        top: 0;
        z-index: 5;
        background: color-mix(in srgb, var(--bg) 92%, transparent);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--line);
        padding: 10px 0;
      }
      .search {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 0 12px;
        max-width: 520px;
      }
      .search:focus-within { border-color: var(--accent); }
      .search svg { width: 18px; height: 18px; fill: none; stroke: var(--muted); stroke-width: 2; flex: none; }
      .search input {
        flex: 1;
        min-width: 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: var(--ink);
        font: inherit;
        font-size: 16px;
        padding: 11px 0;
      }
      .chips {
        display: flex;
        gap: 6px;
        margin-top: 10px;
        overflow-x: auto;
        scrollbar-width: none;
        padding-bottom: 2px;
      }
      .chips::-webkit-scrollbar { display: none; }
      @media (min-width: 900px) { .chips { flex-wrap: wrap; overflow: visible; } }
      @media (max-width: 480px) { .card { padding: 14px 12px; } .spec { font-size: 13.5px; } }
      .chip {
        flex: none;
        border: 0;
        background: var(--chip);
        color: var(--ink);
        font: inherit;
        font-size: 14px;
        padding: 6px 12px;
        border-radius: 999px;
        cursor: pointer;
        white-space: nowrap;
      }
      .chip:hover { background: var(--line); }
      .chip.is-on { background: var(--accent); color: #fff; }

      .brand { padding-top: 28px; }
      .brand h2 {
        display: flex;
        align-items: baseline;
        gap: 8px;
        margin: 0 0 12px;
        font-size: 22px;
        letter-spacing: -0.01em;
      }
      .count { font-size: 14px; font-weight: 500; color: var(--muted); }

      .grid {
        display: grid;
        gap: 12px;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
        align-items: start;
      }
      .card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 16px;
        box-shadow: var(--shadow);
      }
      .card-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; margin-bottom: 10px; }
      .card-head h3 { margin: 0; font-size: 19px; }
      .sub {
        font-size: 13px;
        color: var(--accent);
        background: var(--accent-soft);
        padding: 2px 8px;
        border-radius: 6px;
      }

      .code { margin: -4px 0 10px; color: var(--muted); font-size: 13px; }

      .spec { width: 100%; table-layout: fixed; border-collapse: collapse; font-size: 14px; }
      .spec thead th {
        text-align: left;
        font-size: 12px;
        font-weight: 600;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 0 8px 6px 0;
        border-bottom: 2px solid var(--ink);
      }
      .spec .grp th {
        text-align: left;
        padding: 12px 0 4px;
        font-size: 13px;
        font-weight: 700;
        color: var(--accent);
        border-bottom: 1px solid var(--line);
      }
      .spec td {
        vertical-align: top;
        padding: 7px 8px 7px 0;
        border-bottom: 1px solid var(--line);
        overflow-wrap: break-word;
        hyphens: auto;
      }
      .spec tbody:last-child tr:last-child td { border-bottom: 0; }
      .spec .n { width: 36%; font-weight: 600; }
      .spec .v { width: 24%; padding-right: 0; text-align: right; font-weight: 600; font-variant-numeric: tabular-nums; }
      .spec thead .v { text-align: right; }
      .oil { font-weight: 600; }
      .meta { color: var(--muted); font-size: 13px; }
      .rnote { margin-top: 2px; font-size: 13px; font-style: italic; color: var(--muted); }
      .dash { color: var(--line); }
      .mono { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 12px; }

      .alt { font-size: 13px; color: var(--muted); }
      .alt summary { cursor: pointer; width: max-content; }
      .alt summary:hover { color: var(--ink); }
      .alt ol { margin: 4px 0 0; padding-left: 18px; color: var(--ink); }

      .note {
        margin: 12px 0 0;
        padding: 8px 12px;
        border-left: 3px solid var(--accent);
        background: var(--accent-soft);
        border-radius: 0 8px 8px 0;
        font-size: 14px;
      }

      .legend { margin: 8px 0 0; color: var(--muted); font-size: 14px; }
      .chk {
        display: inline-block;
        font-size: 12px;
        font-weight: 700;
        color: var(--warn-ink);
        background: var(--warn);
        padding: 2px 8px;
        border-radius: 6px;
        white-space: nowrap;
      }
      .chk.sm { display: table; margin-top: 3px; font-size: 11px; padding: 1px 6px; }
      .card[data-check] { border-color: var(--warn-line); }
      .src { font-size: 12px; color: var(--muted); }
      .src:hover { color: var(--ink); }
      .only { display: inline-flex; align-items: center; gap: 6px; margin-top: 8px; font-size: 14px; cursor: pointer; }
      .only input { width: 16px; height: 16px; accent-color: var(--accent); }
      .empty { padding: 40px 0; color: var(--muted); text-align: center; }
      .foot { padding: 40px 16px 32px; color: var(--muted); font-size: 13px; }
      [hidden] { display: none !important; }
    </style>
  </body>
</html>
