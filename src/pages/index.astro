---
import { brands, type Model } from '../data/brands';

const sorted = [...brands].sort((a, b) => a.name.localeCompare(b.name, 'en'));
const modelCount = sorted.reduce((n, b) => n + b.models.length, 0);

// Текст карточки для поиска: марка + всё, что в ней написано.
const searchText = (brand: string, m: Model) =>
  [
    brand,
    m.name,
    m.sub,
    m.note,
    ...(m.units ?? []).flatMap((u) => [u.name, u.vol, u.spec, u.oil, u.part, ...(u.alt ?? [])]),
    ...(m.extra ?? []).flatMap((e) => [e.k, e.v]),
  ]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Масла и расходники</title>
    <meta name="description" content="Что заливать в редукторы, ДВС и системы электромобилей и гибридов: допуски, объёмы, аналоги, фильтры." />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cpath d='M16 3c5 7 9 12 9 17a9 9 0 0 1-18 0c0-5 4-10 9-17z' fill='%23d97706'/%3E%3C/svg%3E" />
  </head>
  <body>
    <header class="top">
      <div class="wrap">
        <h1>Масла и расходники</h1>
        <p class="lead">
          Редукторы, ДВС, охлаждающие и тормозные жидкости, фреон, фильтры. {sorted.length} марок, {modelCount} моделей.
        </p>
      </div>
    </header>

    <div class="bar">
      <div class="wrap">
        <label class="search">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          <input id="q" type="search" placeholder="Модель, допуск, масло, артикул…" autocomplete="off" />
        </label>
        <nav class="chips" aria-label="Марки">
          <button class="chip is-on" data-brand="">Все</button>
          {sorted.map((b) => <button class="chip" data-brand={b.id}>{b.name}</button>)}
        </nav>
      </div>
    </div>

    <main class="wrap">
      {
        sorted.map((b) => (
          <section class="brand" id={b.id} data-brand={b.id}>
            <h2>
              {b.name} <span class="count">{b.models.length}</span>
            </h2>
            <div class="grid">
              {b.models.map((m) => (
                <article class="card" data-search={searchText(b.name, m)}>
                  <header class="card-head">
                    <h3>{m.name}</h3>
                    {m.sub && <span class="sub">{m.sub}</span>}
                  </header>

                  {m.units && (
                    <ul class="units">
                      {m.units.map((u) => (
                        <li class="unit">
                          <div class="unit-head">
                            <span class="unit-name">{u.name}</span>
                            {u.vol && <span class="vol">{u.vol}</span>}
                          </div>
                          {(u.spec || u.oil || u.part) && (
                            <dl class="kv">
                              {u.spec && (
                                <>
                                  <dt>Допуск</dt>
                                  <dd>{u.spec}</dd>
                                </>
                              )}
                              {u.oil && (
                                <>
                                  <dt>Масло</dt>
                                  <dd class="strong">{u.oil}</dd>
                                </>
                              )}
                              {u.part && (
                                <>
                                  <dt>Артикул</dt>
                                  <dd class="mono">{u.part}</dd>
                                </>
                              )}
                            </dl>
                          )}
                          {u.alt &&
                            (u.alt.length > 2 ? (
                              <details class="alt">
                                <summary>Аналоги · {u.alt.length}</summary>
                                <ol>
                                  {u.alt.map((a) => (
                                    <li>{a}</li>
                                  ))}
                                </ol>
                              </details>
                            ) : (
                              <dl class="kv">
                                <dt>Аналог</dt>
                                <dd>{u.alt.join(' · ')}</dd>
                              </dl>
                            ))}
                        </li>
                      ))}
                    </ul>
                  )}

                  {m.extra && (
                    <dl class="extra">
                      {m.extra.map((e) => (
                        <div>
                          <dt>{e.k}</dt>
                          <dd>{e.v}</dd>
                        </div>
                      ))}
                    </dl>
                  )}

                  {m.note && <p class="note">{m.note}</p>}
                </article>
              ))}
            </div>
          </section>
        ))
      }
      <p class="empty" id="empty" hidden>Ничего не нашлось. Попробуйте другое слово или сбросьте марку.</p>
    </main>

    <footer class="wrap foot">Источник – таблица «МАСЛА и прочее», перенесено 22.10.2026. Перед заливкой сверяйте с наклейкой и номером узла на машине.</footer>

    <script>
      const q = document.getElementById('q') as HTMLInputElement;
      const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
      const sections = [...document.querySelectorAll<HTMLElement>('.brand')];
      const empty = document.getElementById('empty')!;
      let brand = '';

      function apply() {
        const words = q.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
        let shown = 0;
        for (const s of sections) {
          const brandOk = !brand || s.dataset.brand === brand;
          let inSection = 0;
          for (const c of s.querySelectorAll<HTMLElement>('.card')) {
            const ok = brandOk && words.every((w) => c.dataset.search!.includes(w));
            c.hidden = !ok;
            if (ok) inSection++;
          }
          s.hidden = inSection === 0;
          shown += inSection;
        }
        empty.hidden = shown > 0;
      }

      for (const chip of chips) {
        chip.addEventListener('click', () => {
          brand = chip.dataset.brand ?? '';
          chips.forEach((c) => c.classList.toggle('is-on', c === chip));
          apply();
          const target = brand ? document.getElementById(brand) : null;
          (target ?? document.querySelector('main'))!.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', brand ? '#' + brand : location.pathname);
        });
      }
      q.addEventListener('input', apply);

      const fromHash = location.hash.slice(1);
      if (fromHash) chips.find((c) => c.dataset.brand === fromHash)?.click();
    </script>

    <style is:global>
      :root {
        --bg: #f6f5f2;
        --surface: #ffffff;
        --ink: #1b1c1e;
        --muted: #6b6e73;
        --line: #e4e2dc;
        --accent: #c2600a;
        --accent-soft: #fdf0e3;
        --chip: #ecebe6;
        --shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 4px 16px rgb(0 0 0 / 0.04);
        color-scheme: light;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          --bg: #121315;
          --surface: #1b1d20;
          --ink: #ececea;
          --muted: #9a9da3;
          --line: #2c2f33;
          --accent: #f0913a;
          --accent-soft: #3a2614;
          --chip: #25282c;
          --shadow: none;
          color-scheme: dark;
        }
      }
      :root[data-theme='dark'] {
        --bg: #121315;
        --surface: #1b1d20;
        --ink: #ececea;
        --muted: #9a9da3;
        --line: #2c2f33;
        --accent: #f0913a;
        --accent-soft: #3a2614;
        --chip: #25282c;
        --shadow: none;
        color-scheme: dark;
      }

      * { box-sizing: border-box; }
      html { scroll-padding-top: 150px; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font: 15px/1.45 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        -webkit-text-size-adjust: 100%;
      }
      .wrap { max-width: 1240px; margin: 0 auto; padding: 0 16px; }

      .top { padding: 32px 0 16px; }
      h1 { margin: 0; font-size: clamp(26px, 4vw, 38px); letter-spacing: -0.02em; }
      .lead { margin: 6px 0 0; color: var(--muted); }

      .bar {
        position: sticky;
        top: 0;
        z-index: 5;
        background: color-mix(in srgb, var(--bg) 92%, transparent);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--line);
        padding: 10px 0;
      }
      .search {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 0 12px;
        max-width: 520px;
      }
      .search:focus-within { border-color: var(--accent); }
      .search svg { width: 18px; height: 18px; fill: none; stroke: var(--muted); stroke-width: 2; flex: none; }
      .search input {
        flex: 1;
        min-width: 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: var(--ink);
        font: inherit;
        font-size: 16px;
        padding: 11px 0;
      }
      .chips {
        display: flex;
        gap: 6px;
        margin-top: 10px;
        overflow-x: auto;
        scrollbar-width: none;
        padding-bottom: 2px;
      }
      .chips::-webkit-scrollbar { display: none; }
      @media (min-width: 900px) { .chips { flex-wrap: wrap; overflow: visible; } }
      .chip {
        flex: none;
        border: 0;
        background: var(--chip);
        color: var(--ink);
        font: inherit;
        font-size: 14px;
        padding: 6px 12px;
        border-radius: 999px;
        cursor: pointer;
        white-space: nowrap;
      }
      .chip:hover { background: var(--line); }
      .chip.is-on { background: var(--accent); color: #fff; }

      .brand { padding-top: 28px; }
      .brand h2 {
        display: flex;
        align-items: baseline;
        gap: 8px;
        margin: 0 0 12px;
        font-size: 22px;
        letter-spacing: -0.01em;
      }
      .count { font-size: 14px; font-weight: 500; color: var(--muted); }

      .grid {
        display: grid;
        gap: 12px;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr));
        align-items: start;
      }
      .card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 16px;
        box-shadow: var(--shadow);
      }
      .card-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; margin-bottom: 10px; }
      .card-head h3 { margin: 0; font-size: 19px; }
      .sub {
        font-size: 13px;
        color: var(--accent);
        background: var(--accent-soft);
        padding: 2px 8px;
        border-radius: 6px;
      }

      .units { list-style: none; margin: 0; padding: 0; }
      .unit { padding: 10px 0; border-top: 1px solid var(--line); }
      .unit:first-child { border-top: 0; padding-top: 0; }
      .unit-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; }
      .unit-name { font-weight: 600; }
      .vol { color: var(--accent); font-weight: 600; font-variant-numeric: tabular-nums; }

      .kv {
        display: grid;
        grid-template-columns: 72px 1fr;
        gap: 2px 10px;
        margin: 6px 0 0;
        font-size: 14px;
      }
      .kv dt { color: var(--muted); }
      .kv dd { margin: 0; overflow-wrap: anywhere; }
      .strong { font-weight: 600; }
      .mono { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 13px; }

      .alt { margin-top: 6px; font-size: 14px; }
      .alt summary { cursor: pointer; color: var(--muted); width: max-content; }
      .alt summary:hover { color: var(--ink); }
      .alt ol { margin: 6px 0 0; padding-left: 20px; }
      .alt li { padding: 1px 0; }

      .extra {
        margin: 12px 0 0;
        padding: 12px;
        background: var(--bg);
        border-radius: 10px;
        display: grid;
        gap: 8px;
        font-size: 14px;
      }
      .extra dt { color: var(--muted); font-size: 13px; }
      .extra dd { margin: 0; overflow-wrap: anywhere; }

      .note {
        margin: 12px 0 0;
        padding: 8px 12px;
        border-left: 3px solid var(--accent);
        background: var(--accent-soft);
        border-radius: 0 8px 8px 0;
        font-size: 14px;
      }

      .empty { padding: 40px 0; color: var(--muted); text-align: center; }
      .foot { padding: 40px 16px 32px; color: var(--muted); font-size: 13px; }
      [hidden] { display: none !important; }
    </style>
  </body>
</html>
