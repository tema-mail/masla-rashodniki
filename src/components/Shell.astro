---
// Общий каркас всех вкладок: head, цвета (светлая/тёмная тема), шапка с вкладками.
interface Props {
  title: string;
  description: string;
  active: 'spravochnik' | 'rashodniki' | 'postavshik';
}
const { title, description, active } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tabs = [
  { id: 'spravochnik', href: `${base}/`, label: 'Справочник' },
  { id: 'rashodniki', href: `${base}/rashodniki/`, label: 'Расходники' },
  { id: 'postavshik', href: `${base}/u-postavshchika/`, label: 'У поставщика' },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cpath d='M16 3c5 7 9 12 9 17a9 9 0 0 1-18 0c0-5 4-10 9-17z' fill='%23d97706'/%3E%3C/svg%3E" />
  </head>
  <body>
    <nav class="tabs" aria-label="Разделы">
      <div class="wrap tabs-in">
        {
          tabs.map((t) => (
            <a href={t.href} class:list={['tab', { 'is-on': t.id === active }]} aria-current={t.id === active ? 'page' : undefined}>
              {t.label}
            </a>
          ))
        }
      </div>
    </nav>
    <slot />

    <style is:global>
      :root {
        --bg: #f6f5f2;
        --surface: #ffffff;
        --ink: #1b1c1e;
        --muted: #6b6e73;
        --line: #e4e2dc;
        --accent: #c2600a;
        --accent-soft: #fdf0e3;
        --chip: #ecebe6;
        --shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 4px 16px rgb(0 0 0 / 0.04);
        --warn: #fde68a;
        --warn-ink: #713f12;
        --warn-line: #f5d565;
        --ok: #dcfce7;
        --ok-ink: #14532d;
        color-scheme: light;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          --bg: #121315;
          --surface: #1b1d20;
          --ink: #ececea;
          --muted: #9a9da3;
          --line: #2c2f33;
          --accent: #f0913a;
          --accent-soft: #3a2614;
          --chip: #25282c;
          --shadow: none;
          --warn: #4a3a0a;
          --warn-ink: #fcd34d;
          --warn-line: #6b5410;
          --ok: #12331f;
          --ok-ink: #86efac;
          color-scheme: dark;
        }
      }
      :root[data-theme='dark'] {
        --bg: #121315;
        --surface: #1b1d20;
        --ink: #ececea;
        --muted: #9a9da3;
        --line: #2c2f33;
        --accent: #f0913a;
        --accent-soft: #3a2614;
        --chip: #25282c;
        --shadow: none;
        --warn: #4a3a0a;
        --warn-ink: #fcd34d;
        --warn-line: #6b5410;
        --ok: #12331f;
        --ok-ink: #86efac;
        color-scheme: dark;
      }

      * { box-sizing: border-box; }
      html { scroll-padding-top: 150px; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font: 15px/1.45 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        -webkit-text-size-adjust: 100%;
      }
      .wrap { max-width: 1240px; margin: 0 auto; padding: 0 16px; }

      .top { padding: 24px 0 16px; }
      h1 { margin: 0; font-size: clamp(26px, 4vw, 38px); letter-spacing: -0.02em; }
      .lead { margin: 6px 0 0; color: var(--muted); }

      .tabs { background: var(--surface); border-bottom: 1px solid var(--line); }
      .tabs-in { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; }
      .tab {
        flex: none;
        padding: 12px 14px;
        color: var(--muted);
        text-decoration: none;
        font-weight: 600;
        border-bottom: 2px solid transparent;
        white-space: nowrap;
      }
      .tab:hover { color: var(--ink); }
      .tab.is-on { color: var(--ink); border-bottom-color: var(--accent); }
    </style>
  </body>
</html>
